# 此文件仅列出变量名，不要在仓库中保存真实密钥。

# Web
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_FRONTEND_ORIGIN=http://localhost:3000

# OpenAI-compatible Chat
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
RAG_CHAT_MODEL=
RAG_CHAT_THINK=

# Embedding 默认使用本地 BAAI/bge-small-zh-v1.5；模型、维度和后端默认值维护在 config.py。
# 仅在临时切换到 OpenAI Embeddings API 时设置：
# RAG_EMBEDDING_BACKEND=openai
# RAG_EMBEDDING_MODEL=your-embedding-model

# 本地 rerank、PDF 解析管线、检索 top_k 等默认配置统一在 backend/src/backend/config.py 中维护。

# MinerU Compose Web API（项目内 deploy/mineru/compose.yaml，API 对外使用 8001）
# RAG_DOCUMENT_PIPELINE=mineru
# RAG_MINERU_API_URL=http://127.0.0.1:8001
# RAG_MINERU_AUTO_START=true
# RAG_MINERU_COMPOSE_DIR=E:\\lmq\\RAG_ZB\\deploy\\mineru
