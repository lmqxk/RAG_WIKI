# 此文件仅列出变量名，不要在仓库中保存真实密钥。

# Web
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_FRONTEND_ORIGIN=http://localhost:3000

# OpenAI-compatible Chat / Embedding
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
RAG_CHAT_MODEL=
RAG_CHAT_MAX_TOKENS=1024
RAG_CHAT_THINK=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSION=384

# 可选 Rerank 接口
RAG_RERANK_BASE_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=

# PDF 解析：默认全量 MinerU；调试或轻量 fallback 可改为 rapidocr
RAG_SCAN_PARSER=mineru
RAG_OCR_RENDER_DPI=180

# MinerU
RAG_MINERU_BACKEND=pipeline
RAG_MINERU_METHOD=auto
RAG_MINERU_OCR_LANG=ch
RAG_MINERU_MODEL_SOURCE=modelscope

# 首版容量限制
RAG_MAX_FILE_SIZE_MB=100
RAG_MAX_PDF_PAGES=600
RAG_MAX_WORKERS=1
