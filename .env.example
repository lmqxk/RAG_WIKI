# 此文件仅列出变量名，不要在仓库中保存真实密钥。

# Web
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_FRONTEND_ORIGIN=http://localhost:3000
RAG_FRONTEND_HOST=127.0.0.1
RAG_FRONTEND_PORT=3000

# 局域网模式示例：将这三项改为本机实际 IPv4，例如 10.0.2.208。
# RAG_API_HOST=0.0.0.0
# RAG_FRONTEND_HOST=0.0.0.0
# RAG_FRONTEND_ORIGIN=http://10.0.2.208:3000

# OpenAI-compatible Chat
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
RAG_CHAT_MODEL=
RAG_CHAT_THINK=

# Embedding 默认使用本地 BAAI/bge-small-zh-v1.5；模型、维度和后端默认值维护在 config.py。
# 仅在临时切换到 OpenAI Embeddings API 时设置：
# Jina Embedding（JINA_API_KEY 同时用于 Jina Rerank）。
# RAG_EMBEDDING_BACKEND=openai
# RAG_EMBEDDING_BASE_URL=https://api.jina.ai/v1
# RAG_EMBEDDING_MODEL=jina-embeddings-v5-text-small
# RAG_EMBEDDING_DIMENSION=1024
# RAG_EMBEDDING_COLLECTION_NAME=document_chunks_jina_embeddings_v5_small_v1
# RAG_RERANK_BASE_URL=https://api.jina.ai/v1/rerank
# RAG_RERANK_MODEL=jina-reranker-v3
# 本地 Embedding 失败时的硅基流动后备服务；BGE-large 原生 1024 维，需匹配索引维度。
# RAG_EMBEDDING_FALLBACK_ENABLED=true
# RAG_EMBEDDING_FALLBACK_BASE_URL=https://api.siliconflow.cn/v1
# RAG_EMBEDDING_FALLBACK_API_KEY=sk-...
# RAG_EMBEDDING_FALLBACK_MODEL=BAAI/bge-large-zh-v1.5
# Hugging Face Inference 后备（与当前 512 维本地索引兼容）。
# RAG_EMBEDDING_HF_FALLBACK_ENABLED=true
# RAG_EMBEDDING_HF_API_TOKEN=hf_...
# RAG_EMBEDDING_HF_MODEL=BAAI/bge-small-zh-v1.5
# RAG_EMBEDDING_HF_PROVIDER=hf-inference
# Hugging Face Inference 后备（优先于硅基流动后备）。
# HUGGINGFACEHUB_API_TOKEN=hf_...
# RAG_HUGGINGFACE_FALLBACK_ENABLED=true
# RAG_HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 主重排序服务失败时的硅基流动后备服务。
# RAG_RERANK_FALLBACK_ENABLED=true
# RAG_RERANK_FALLBACK_URL=https://api.siliconflow.cn/v1/rerank
# RAG_RERANK_FALLBACK_API_KEY=sk-...
# RAG_RERANK_FALLBACK_MODEL=BAAI/bge-reranker-v2-m3

# 本地 rerank、PDF 解析管线、检索 top_k 等默认配置统一在 backend/src/backend/config.py 中维护。

# PaddleOCR-VL Compose API（项目内 deploy/paddlevl/compose.yaml，API 默认 8080）
# RAG_DOCUMENT_PIPELINE=paddlevl
# RAG_PADDLEVL_API_URL=http://127.0.0.1:8080
# RAG_PADDLEVL_AUTO_START=true
# RAG_DOCUMENT_PIPELINE=mineru
# RAG_MINERU_API_URL=http://127.0.0.1:8001
# RAG_MINERU_AUTO_START=true
# RAG_MINERU_COMPOSE_DIR=E:\\lmq\\RAG_ZB\\deploy\\mineru
